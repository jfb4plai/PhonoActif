  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^31.0.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
