{
  "name": "phonoactif",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:py": "python -m unittest discover -s tools -p \"test_*.py\"",
    "dev": "vite --port 5199",
